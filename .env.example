BWS_ACCESS_TOKEN=
BWS_TEST_CREDENTIALS_SECRET=

CLOUDINARY_URL=

# Set to "true" if postcode polygons have been legally licensed
ENABLE_DATABASE_POSTCODE_LOOKUP=

DATABASE_URL=postgres://postgres:postgres@localhost:5444/postgres

DEFAULT_QUEUE_NAME=default

# JSON map from flag to list of allowed email addresses
FEATURE_FLAG_EMAIL_ALLOWLISTS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

JWT_SECRET=keyboardcat

LOG_LEVEL=debug

MAPBOX_SECRET_TOKEN=

# File storage. Leave MINIO_DOMAIN empty to keep files in local folders, or
# use the docker compose MinIO (docker compose --profile minio up -d) with the
# values below. Never use the production MinIO locally.
MINIO_DOMAIN=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Defaults are 443 and true. For the docker compose MinIO: 9000 and false
MINIO_PORT=
MINIO_USE_SSL=
# Random values for the docker compose MinIO's root user (openssl rand -hex 24).
# Use the same values for MINIO_ACCESS_KEY and MINIO_SECRET_KEY.
LOCAL_MINIO_ROOT_USER=
LOCAL_MINIO_ROOT_PASSWORD=
# Bucket for files that must never be public, e.g. uploaded CSVs. Must have
# no anonymous access policy. Defaults to ts-mapped-private.
MINIO_PRIVATE_BUCKET=

# Set backend URL on remote servers
NEXT_PUBLIC_BASE_URL=
# JSON map to boolean, e.g. '{"public-maps": true}'
NEXT_PUBLIC_FEATURE_FLAGS=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SANITY_STUDIO_DATASET=
NEXT_PUBLIC_SANITY_STUDIO_PROJECT_ID=
NEXT_PUBLIC_SANITY_STUDIO_API_VERSION=
NEXT_PUBLIC_SENTRY_DSN=

NODE_ENV=development

# Required for webhooks in dev environment
NGROK_AUTHTOKEN=

REDIS_URL=redis://localhost:6380

SANITY_STUDIO_DATASET=
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_API_VERSION=

# Set to any value (apart from 0 or false) to skip starting a worker on app startup
SKIP_WORKER=

ZETKIN_CLIENT_ID=
ZETKIN_CLIENT_SECRET=
